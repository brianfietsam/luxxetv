{
  "name": "luxxetv",
  "version": "1.2.0",
  "description": "LuxxeTV - Xtream Codes DVR with a Tesla-friendly web player",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server/standalone.js",
    "mock": "node test/mock-xtream.js",
    "test": "node test/e2e.js",
    "predist": "node scripts/build-info.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.21.2",
    "hls.js": "^1.5.20"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.luxxetv.dvr",
    "productName": "LuxxeTV",
    "files": ["electron/**", "server/**", "public/**", "assets/**", "build-info.json", "node_modules/hls.js/dist/hls.min.js"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
